<Window x:Class="ShoeStoreManager.Shoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shoe Store Manager" Height="450" Width="800"
        Background="#E2EAF4" Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="747*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#C1D1E8" Padding="0,5,0,5" Grid.ColumnSpan="2" Margin="0,0,0,36">
            <MenuItem Header="Файл" Width="165" HorizontalContentAlignment="Center">
                <MenuItem Header="Зберегти та Завантажити файл" Click="SaveSelBtn_Click"/>
            </MenuItem>

            <MenuItem Header="Модель" Width="401" HorizontalContentAlignment="Center">
                <MenuItem Header="Додати модель" Click="AddMenuItem_Click"/>
                <MenuItem Header="Редагувати модель" Click="EditMenuItem_Click" />
                <MenuItem Header="Видалити модель" Click="DeleteMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="Вихід" Width="180" HorizontalContentAlignment="Center" Click="BackToMain_Click"/>
        </Menu>

        <Grid Margin="10,38,10,10" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ShoesDataGrid" Grid.Column="0" AutoGenerateColumns="False" 
                      Background="White" RowBackground="White" AlternatingRowBackground="#F0F5FA" 
                      HeadersVisibility="Column" BorderBrush="#9CB6D9" BorderThickness="1" IsReadOnly="True">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Додати" Click="AddMenuItem_Click"/>
                        <MenuItem Header="Редагувати" Click="EditMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="Видалити" Click="DeleteMenuItem_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Width="70" Binding="{Binding item_number}"/>
                    <DataGridTextColumn Header="Назва моделі" Width="*" Binding="{Binding name}"/>
                    <DataGridTextColumn Header="Кількість" Width="70" Binding="{Binding count}"/>
                    <DataGridTextColumn Header="Вартість" Width="70" Binding="{Binding price_one_pair}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="Додавання&#x0a;моделі" TextAlignment="Center" FontSize="11" Margin="0,0,0,5" Foreground="#1D2A3A"/>

                <Button Content="+" FontSize="24" FontWeight="Bold" Width="40" Height="40" Background="#E2EAF4" BorderBrush="#9CB6D9" BorderThickness="2" Foreground="#1D2A3A" Margin="0,0,0,10" Click="Button_Click_1">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="✎" FontSize="20" Width="40" Height="40" Background="#E2EAF4" BorderBrush="#9CB6D9" BorderThickness="2" Foreground="#1D2A3A" Click="EditButton_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Редагування&#x0a;моделі" TextAlignment="Center" FontSize="11" Foreground="#1D2A3A"/>

            </StackPanel>

            <Border Grid.Column="2" Background="#9CB6D9" CornerRadius="8" Padding="15" VerticalAlignment="Center">
                <StackPanel>

                    <Border BorderBrush="#7A98C4" BorderThickness="0,0,0,2" Padding="5" Margin="0,0,0,15">
                        <TextBlock Text="Модель" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="#1D2A3A"/>
                    </Border>

                    <TextBox x:Name="txtArticle" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <TextBox x:Name="txtName" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <TextBox x:Name="txtCount" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <TextBox x:Name="txtPrice" Height="28" Margin="0,0,0,15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <Button Content="Зберегти" Height="32" Background="#00478E" Foreground="White" FontWeight="Bold" Click="Button_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>